    "morgan": "^1.12.1",
    "multer": "^2.3.0",
    "uuid": "^14.0.2",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.2",
    "@types/uuid": "^11.0.0",
    "rimraf": "^6.1.3",
