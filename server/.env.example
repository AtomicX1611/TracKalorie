# ─── Server Environment ───────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/trackalorie

# ─── Single-Tenant Auth (legacy stub — not used with JWT build) ───────────────
SINGLE_TENANT_USER_ID=00000000-0000-0000-0000-000000000001

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated if you have more than one hosted frontend origin.
CLIENT_ORIGIN=https://your-client-domain.example

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_a_random_256bit_hex_string
JWT_EXPIRES_IN=15m
